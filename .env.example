# Non-secret settings. Every one is optional; the value shown is the default.
# Secrets (database, OpenAI, Langfuse) are read from AWS Secrets Manager, never from here.

AWS_REGION=us-east-2
LANGFUSE_HOST=https://us.cloud.langfuse.com

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=5000

VECTOR_MIN_SIMILARITY=0.30
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_BRANCH_LIMIT=50
RRF_K=60
IVFFLAT_ROWS_PER_LIST=1000
IVFFLAT_MAX_LISTS=10
IVFFLAT_PROBES=10

ASSIST_MAX_RESULTS=5
ASSIST_DEFAULT_MULTIPLIER=3
ASSIST_MAX_MULTIPLIER=5
VALIDATION_BATCH_SIZE=15
VALIDATION_MAX_BATCHES=4
MAX_QUESTION_LENGTH=2000

INGEST_MAX_ITEMS=500
SEED=42
SEED_REPEATS=2
SEED_MIN_INCIDENTS=200
SEED_MAX_INCIDENTS=999
CATALOG_PATH=data/service_catalog.json

# Live tests only (pytest -m live)
API_BASE_URL=http://18.222.137.172:8000
